# Force LF in repo (avoid CRLF warnings/drift)
* text=auto eol=lf

# Markdown / HTML / CSS / JS
*.md  text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf

# Images/binaries
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.pdf  binary
